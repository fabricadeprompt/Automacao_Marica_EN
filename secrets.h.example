#pragma once
// =============================================================
// SECRETS.H.EXAMPLE -- template de credenciais
// =============================================================
// 1. Copie este arquivo para "secrets.h" (mesma pasta)
// 2. Preencha com as suas credenciais reais
// 3. "secrets.h" (sem o .example) NUNCA deve ser commitado -- ja esta
//    listado no .gitignore deste repositorio
// =============================================================

// --- Wi-Fi (usado por Caixa Bomba e Caixa Controle, janela de OTA) ---
#define WIFI_SSID "SUA_REDE_WIFI"
#define WIFI_PASS "SUA_SENHA_WIFI"

// --- Supabase (usado só pela Caixa Controle) ---
// Deixe "SEU_PROJETO" no lugar se ainda não tiver um projeto Supabase --
// o firmware detecta o placeholder e desativa o envio automaticamente,
// sem precisar comentar código.
#define SUPABASE_URL "https://SEU_PROJETO.supabase.co"
#define SUPABASE_KEY "SUA_CHAVE_ANON_AQUI"
